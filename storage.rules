rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is admin by email (no Firestore reads to avoid CORS loops)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'shivampatidar780@gmail.com' ||
        request.auth.token.email.matches('.*admin.*')
      );
    }

    // Check file ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Gallery images — public read, admin write
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificate templates
    match /templates/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User invoices
    match /invoices/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // User certificates
    match /certificates/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Team member images — public read, admin write
    match /team/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mentor images — public read, admin write
    match /mentors/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
